{
    "name": "silverstripe/multiform",
    "description": "SilverStripe forms with multiple steps, flow control and state persistence",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "forms"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\MultiForm\\": "src/",
            "SilverStripe\\MultiForm\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "lint:phpstan": "phpstan analyse --memory-limit=-1",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage --coverage-text"
    }
}
